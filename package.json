{
  "name": "bookmark",
  "version": "1.0.0",
  "private": true,
  "description": "A simple bookmarking application- voltado á analise de anotaçoes .",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/print-urls.js && concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:all": "npm run db:up && npm run dev",
    "db:up": "docker compose up -d",
    "db:up:wsl": "wsl -d Ubuntu -- docker compose up -d",
    "dev:wsl": "npm run db:up:wsl && npm run dev",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=apps/api",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "db:studio": "npm run db:studio --workspace=apps/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
